# NextAuth Configuration
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=your-nextauth-secret-here

# Microsoft Entra sign-in (NextAuth Azure AD provider)
AZURE_AD_CLIENT_ID=your-signin-app-client-id
AZURE_AD_CLIENT_SECRET=your-signin-app-client-secret
AZURE_AD_TENANT_ID=your-tenant-id

# Extra admin emails, comma separated. daniel@ and rasmus@ are always admins.
# ALLOWED_USERS=someone@wolthers.com,someone-else@wolthers.com

# Vercel Blob Storage (automatically provided by Vercel in production)
# BLOB_READ_WRITE_TOKEN=your-blob-token-here

# ---------------------------------------------------------------------------
# Automatic message trace sync via Microsoft Graph. See docs/graph-sync.md for
# the Entra app registration steps. Leave unset to keep manual CSV upload only.
# ---------------------------------------------------------------------------

# Separate app registration from the sign-in one above: this needs the
# ExchangeMessageTrace.Read.All APPLICATION permission with admin consent.
GRAPH_CLIENT_ID=your-graph-sync-app-client-id
GRAPH_CLIENT_SECRET=your-graph-sync-app-client-secret
# Optional — falls back to AZURE_AD_TENANT_ID when unset.
# GRAPH_TENANT_ID=your-tenant-id

# Bearer token Vercel Cron sends to /api/sync-graph. Generate with:
#   openssl rand -hex 32
CRON_SECRET=a-long-random-string

# Production values for Vercel deployment:
# NEXTAUTH_URL=https://mails.wolthers.com
# NEXTAUTH_SECRET=generate-a-secure-secret-for-production
